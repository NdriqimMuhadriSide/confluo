# Copy to .env (`make setup` does this). Every variable is optional in local dev:
# the defaults below match the Supabase local stack started by `make db`.
# Python processes read CONFLUO_* via pydantic-settings (packages/core/src/confluo_core/settings.py).

# --- General -----------------------------------------------------------------
# local | test | staging | production. `local` enables API auto-reload.
CONFLUO_ENV=local
# Python log level: DEBUG, INFO, WARNING, ERROR.
CONFLUO_LOG_LEVEL=INFO

# --- Database / Supabase ------------------------------------------------------
# App connection used by the API and worker. It logs in as `confluo_app`, a role that
# owns no tables and cannot bypass row-level security. Local Supabase is on port 54322.
CONFLUO_DATABASE_URL=postgresql://confluo_app:confluo_app@127.0.0.1:54322/postgres
# Owner connection used by migrations (`make migrate`) and admin scripts only.
CONFLUO_MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Password `make migrate` gives the confluo_app role; must match CONFLUO_DATABASE_URL.
# The local default is refused in staging/production.
CONFLUO_APP_DB_PASSWORD=confluo_app
# Supabase API URL (Auth, Storage). `supabase status` prints the local one.
CONFLUO_SUPABASE_URL=http://127.0.0.1:54321
# Expected `aud` claim of staff access tokens. The API verifies tokens against the
# public keys at $CONFLUO_SUPABASE_URL/auth/v1/.well-known/jwks.json (no secret needed).
CONFLUO_SUPABASE_JWT_AUDIENCE=authenticated
# Expected `iss` claim. Leave empty to use $CONFLUO_SUPABASE_URL/auth/v1; only needs
# setting when the API reaches Supabase under another host (see infra/docker-compose.yml).
CONFLUO_SUPABASE_JWT_ISSUER=

# Server-side Supabase key, used only to send invitation emails. Never commit it and
# never expose it to the browser. Locally, `make dev` / `make up` read it from
# `supabase status`, so leave this commented out. Cloud: Project Settings → API Keys.
# CONFLUO_SUPABASE_SECRET_KEY=

# --- API ----------------------------------------------------------------------
# Interface and port the API binds to.
CONFLUO_API_HOST=127.0.0.1
CONFLUO_API_PORT=8100
# Browser origins allowed by CORS, as a JSON list (single-quoted so honcho keeps the inner quotes).
CONFLUO_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# --- LLM gateway ----------------------------------------------------------------
# "provider:model" per tier; providers: anthropic, voyage, fake (offline, free).
CONFLUO_LLM_FAST=anthropic:claude-haiku-4-5
CONFLUO_LLM_DIALOGUE=anthropic:claude-opus-5
CONFLUO_LLM_EMBEDDING=voyage:voyage-3.5
# Provider keys (never commit them). `make smoke-llm` makes one real call each.
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# --- Jobs and webhooks ---------------------------------------------------------
# Attempts per background job (then it is dead-lettered in Settings → System health),
# and the first retry delay in seconds; it doubles on each attempt.
CONFLUO_JOB_MAX_ATTEMPTS=5
CONFLUO_JOB_RETRY_BASE_SECONDS=10
# Secret for the built-in `test` webhook provider (local/test only; ignored elsewhere).
# Signed with HMAC-SHA256 in the X-Confluo-Signature header. Used by `make e2e`.
CONFLUO_WEBHOOK_TEST_SECRET=local-webhook-test-secret

# --- Worker -------------------------------------------------------------------
# Seconds between worker heartbeats (placeholder until the job queue card).
CONFLUO_WORKER_HEARTBEAT_SECONDS=30

# --- Web dashboard (Next.js, server side) -------------------------------------
# Where the dashboard's server reaches the API.
CONFLUO_API_URL=http://127.0.0.1:8100
# Supabase URL and publishable key used by the dashboard for sign-in (browser-safe).
# The values below are the fixed defaults of the Supabase local stack (`supabase status`).
# For the cloud project: Project Settings → API Keys → publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Where the dashboard's server (not the browser) reaches Supabase. Leave empty to use
# NEXT_PUBLIC_SUPABASE_URL; docker-compose sets it to host.docker.internal.
SUPABASE_INTERNAL_URL=
